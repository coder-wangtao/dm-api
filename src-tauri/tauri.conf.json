{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DamaoAPI",
  "version": "0.3.4",
  "identifier": "damaoapi.wangtao.cn",
  "mainBinaryName": "damaoapi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DamaoAPI - Local LLM Gateway",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680,
        "decorations": true,
        "dragDropEnabled": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/pdfium/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
